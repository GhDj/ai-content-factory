# ─────────────────────────────────────────────────────────────
# AI Content Factory — environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# LLM used for topic ranking, script writing, and viral scoring.
# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Stock video backgrounds (fallback when HuggingFace quota runs out).
# Free, 200 req/hour: https://www.pexels.com/api/
PEXELS_API_KEY=

# AI-generated backgrounds via FLUX.1 (text → image).
# Free tier ~3-4 images/day before 402. Cached per topic.
# https://huggingface.co/settings/tokens (inference scope)
HUGGINGFACE_API_KEY=hf_...

# Voiceover TTS.
# Free tier ~10k chars/mo; paid from $5/mo.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...
# Voice ID — pick any voice from https://elevenlabs.io/app/voice-lab
# Copy the ID shown in the Voices tab.
ELEVENLABS_VOICE_ID=

# YouTube Data API v3 — for auto-uploading YouTube Shorts.
# Google Cloud Console → enable "YouTube Data API v3" →
# Credentials → OAuth client ID → Desktop app.
# Then run: npm run auth:youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional — only matters if you revive the (currently disabled) Playwright
# TikTok uploader. Set to "true" for headless. TikTok detects bots in headless
# mode so "false" is recommended when using it.
PLAYWRIGHT_HEADLESS=false
